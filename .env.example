# Plantilla de variables de entorno (segura para commitear).
# Copiar a .env y rellenar con los valores reales.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Next.js (expuestos al navegador)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

DATABASE_URL='postgresql://postgres:YOUR-PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres'

PGHOST=db.YOUR-PROJECT-REF.supabase.co
PGPORT=5432
PGUSER=postgres
PGPASSWORD=YOUR-PASSWORD
PGDATABASE=postgres

SUPABASE_PROJECT_REF=YOUR-PROJECT-REF

# OpenAI — generación de imágenes (solo server-side)
OPENAI_API_KEY=sk-proj-xxx
OPENAI_IMAGE_MODEL=gpt-image-1

# E2E (Playwright)
E2E_ADMIN_EMAIL=admin@example.com
E2E_ADMIN_PASSWORD=changeme

# EasyCancha — reservas de canchas (solo server-side; header "apikey")
EASYCANCHA_API_URL=https://www.easycancha.com/api
EASYCANCHA_TOKEN=your-easycancha-api-token
EASYCANCHA_CLUB_ID=000

# Resend — correos transaccionales (solo server-side; dominio del remitente verificado)
RESEND_API_KEY=re_xxx
RESEND_FROM=correos@tu-dominio.com
